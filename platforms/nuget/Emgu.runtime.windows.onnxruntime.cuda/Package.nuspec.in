<?xml version="1.0"?>
<package >
  <metadata>
    <id>${EMGU_ONNXRUNTIME_CUDA_NUGET_ID}</id>
	  <title>Native x64 ONNX Runtime CUDA/TensorRT execution provider dependency for EMGU CV</title>
    <version>${EMGU_ONNXRUNTIME_CUDA_VERSION}</version>
    <authors>${CPACK_PACKAGE_VENDOR}</authors>
    <owners>${CPACK_PACKAGE_VENDOR}</owners>
    <license type="file">LICENSE.txt</license>
    <projectUrl>${NUGET_EMGU_URL}</projectUrl>
	  <icon>nuget_icon.png</icon>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
	  <summary>This package provides the native ONNX Runtime CUDA and TensorRT execution provider dependency</summary>
    <description>This package provides the native ONNX Runtime CUDA and TensorRT GPU execution provider libraries for EMGU software libraries. It is only needed when the build uses ONNX Runtime with CUDA/TensorRT GPU acceleration; the base ${EMGU_ONNXRUNTIME_NUGET_ID} package is still required alongside it.</description>
    <releaseNotes>This is the ${EMGU_ONNXRUNTIME_CUDA_VERSION} release of ONNX Runtime.</releaseNotes>
	  <readme>docs/README.md</readme>
    <copyright>© ${CPACK_PACKAGE_VENDOR} ${CURRENT_YEAR}. All rights reserved</copyright>
    <tags>native emgu onnx onnxruntime cuda tensorrt</tags>
    <dependencies>
      <dependency id="${EMGU_ONNXRUNTIME_NUGET_ID}" version="${EMGU_ONNXRUNTIME_VERSION}" />
    </dependencies>
  </metadata>
  <files>
	<file src="Emgu.runtime.windows.onnxruntime.cuda.targets" target="build\net461\${EMGU_ONNXRUNTIME_CUDA_NUGET_ID}.targets" />
	<file src="Emgu.runtime.windows.onnxruntime.cuda.targets" target="buildTransitive\net461\${EMGU_ONNXRUNTIME_CUDA_NUGET_ID}.targets" />

	  <file src="..\..\..\libs\runtimes\win-x64\native\onnxruntime_providers_cuda.dll" target="runtimes\win-x64\native" />
	  <file src="..\..\..\libs\runtimes\win-x64\native\onnxruntime_providers_tensorrt.dll" target="runtimes\win-x64\native" />
	  <file src="..\..\..\miscellaneous\nuget_icon.png" target="" />
	  <file src="LICENSE.txt" target="" />
	  <file src="README.md" target="docs\" />
  </files>
</package>
