#!/bin/bash -ve

cd "$(dirname "$0")"

# By default the image codec libraries (libtiff, libpng, libjpeg, libwebp, OpenJPEG)
# and libgeotiff are linked from the system copies installed by
# apt_install_dependency, wherever they are found. Pass --build-from-source (anywhere
# in the arguments) to build them, plus PROJ, from source and link them statically
# instead, so libcvextern.so doesn't need them installed at runtime.
USE_SYSTEM_LIBS=TRUE
POSITIONAL_ARGS=()
for arg in "$@"; do
    if [ "$arg" == "--build-from-source" ]; then
        USE_SYSTEM_LIBS=FALSE
    else
        POSITIONAL_ARGS+=("$arg")
    fi
done
set -- "${POSITIONAL_ARGS[@]}"

if [ "$USE_SYSTEM_LIBS" == "TRUE" ]; then
    BUILD_3RDPARTY=FALSE
else
    BUILD_3RDPARTY=TRUE
fi
THIRDPARTY_OPTIONS=( -DBUILD_TIFF:BOOL=$BUILD_3RDPARTY -DBUILD_PNG:BOOL=$BUILD_3RDPARTY -DBUILD_JPEG:BOOL=$BUILD_3RDPARTY -DBUILD_WEBP:BOOL=$BUILD_3RDPARTY -DBUILD_OPENJPEG:BOOL=$BUILD_3RDPARTY -DBUILD_JASPER:BOOL=$BUILD_3RDPARTY -DBUILD_OPENEXR:BOOL=$BUILD_3RDPARTY -DEMGU_CV_USE_SYSTEM_GEOTIFF:BOOL=$USE_SYSTEM_LIBS )

INSTALL_FOLDER=$PWD/build/install
SCRIPT_FOLDER=$PWD

BUILD_TYPE=full
BUILD_CUDA=false
if [[ $# -gt 0 ]]; then
    if [ "$1" == "mini" ]; then
	BUILD_TYPE=mini
    elif [ "$1" == "core" ]; then
	BUILD_TYPE=core
    elif [ "$1" == "cuda" ]; then
	BUILD_CUDA=true
    fi 
fi

if [ "$BUILD_CUDA" = true ]; then
    CUDA_OPTIONS=( -DWITH_CUDA:BOOL=TRUE -DOPENCV_DNN_CUDA:BOOL=TRUE -DBUILD_SHARED_LIBS:BOOL=TRUE -DOPENCV_CMAKE_CUDA_DEBUG:BOOL=TRUE -DCMAKE_CUDA_ARCHITECTURES:BOOL=TRUE )
    export CC=cuda-gcc
    export CXX=cuda-g++
else
    CUDA_OPTIONS=( -DWITH_CUDA:BOOL=FALSE -DOPENCV_DNN_CUDA:BOOL=FALSE -DBUILD_SHARED_LIBS:BOOL=FALSE )
    CUDA_ENV_VAR=( )
fi

EMGUCV_CMAKE_SHARED_OPTIONS=( -DCMAKE_POSITION_INDEPENDENT_CODE:BOOL=ON -DCMAKE_BUILD_TYPE:STRING="Release" -DCMAKE_INSTALL_PREFIX:STRING="$INSTALL_FOLDER" -DCMAKE_FIND_ROOT_PATH:STRING="$INSTALL_FOLDER" -DCMAKE_CXX_STANDARD:String="17" )

cd ../../..

#cd eigen
#mkdir -p build
#cd build
#cmake ${EMGUCV_CMAKE_SHARED_OPTIONS[@]} ..
#cmake --build . --config Release --target install --parallel
#cd ../..


if [ "$BUILD_TYPE" == "mini" ]; then
    echo "Performing a mini build"
    TESSERACT_OPTION=-DEMGU_CV_WITH_TESSERACT:BOOL=FALSE
    VTK_OPTION=
    # flann must stay enabled: in OpenCV 5 imgproc depends on geometry, which depends on flann.
    CONTRIB_OPTION=( -DBUILD_opencv_calib:BOOL=FALSE -DBUILD_opencv_dnn:BOOL=FALSE -DBUILD_opencv_photo:BOOL=FALSE -DBUILD_opencv_features:BOOL=FALSE -DBUILD_opencv_video:BOOL=FALSE )
elif [ "$BUILD_TYPE" == "core" ]; then
    echo "Performing a core build"
    TESSERACT_OPTION=-DEMGU_CV_WITH_TESSERACT:BOOL=FALSE
    VTK_OPTION=
    CONTRIB_OPTION=( )
else
    echo "Performing a full build"
    TESSERACT_OPTION=-DEMGU_CV_WITH_TESSERACT:BOOL=TRUE
    #cd hdf5
    #mkdir -p build
    #cd build
    #cmake ${EMGUCV_CMAKE_SHARED_OPTIONS[@]} -DBUILD_SHARED_LIBS:BOOL=OFF -DBUILD_TESTING:BOOL=FALSE -DHDF5_BUILD_EXAMPLES:BOOL=FALSE -DHDF5_BUILD_TOOLS:BOOL=FALSE -DHDF5_BUILD_UTILS:BOOL=FALSE ..
    #cmake --build . --config Release --target install --parallel
    #cd ../..
    
    #cd vtk
    #mkdir -p build
    #cd build
    #cmake ${EMGUCV_CMAKE_SHARED_OPTIONS[@]} -DBUILD_TESTING:BOOL=FALSE -DBUILD_SHARED_LIBS:BOOL=FALSE ..
    #cmake --build . --config Release --target install --parallel
    #VTK_OPTION=-DVTK_DIR:String="$INSTALL_FOLDER"
    #cd ../..

    CONTRIB_OPTION=( -DWITH_VTK:BOOL=TRUE -DWITH_GSTREAMER:BOOL=TRUE -DOPENCV_EXTRA_MODULES_PATH=../../../../opencv_contrib/modules )
fi

cd $SCRIPT_FOLDER

mkdir -p build
cd build
cmake \
      ${EMGUCV_CMAKE_SHARED_OPTIONS[@]} \
      $TESSERACT_OPTION \
      ${CUDA_OPTIONS[@]} \
      -DCMAKE_POSITION_INDEPENDENT_CODE:BOOL=TRUE \
      -DBUILD_TESTS:BOOL=FALSE \
      -DWITH_UNIFONT:BOOL=ON \
      -DWITH_ITALICFONT:BOOL=ON \
      ${THIRDPARTY_OPTIONS[@]} \
      -DBUILD_JAVA:BOOL=FALSE \
      -DBUILD_PERF_TESTS:BOOL=FALSE \
      -DBUILD_opencv_apps:BOOL=FALSE \
      -DBUILD_DOCS:BOOL=FALSE \
      ${CONTRIB_OPTION[@]} \
      -DBUILD_opencv_ts:BOOL=FALSE \
      -DBUILD_opencv_java:BOOL=FALSE \
      -DBUILD_opencv_python2:BOOL=FALSE \
      -DBUILD_opencv_python3:BOOL=FALSE \
      $VTK_OPTION \
      -DWITH_EIGEN:BOOL=TRUE \
      $PWD/../../../..
      #-DEigen3_DIR:String="$INSTALL_FOLDER" \

#      -DWITH_TBB:BOOL=TRUE \
#      -DWITH_CUDA:BOOL=FALSE \
    
#C_INCLUDE_PATH=$PWD/../../../../eigen/:$INSTALL_FOLDER/include/vtk-9.2 CPLUS_INCLUDE_PATH=$PWD/../../../../eigen/:$INSTALL_FOLDER/include/vtk-9.2:$PWD/../../../../harfbuzz/src:$INSTALL_FOLDER/include/harfbuzz make
#make

# If a build target is specified as the 2nd parameter, build the target.
# If not specified, do not build target, only configuration will be performed.
if [[ $# -gt 1 ]]; then
  cmake --build . --config Release --target $2
fi

#if [ "$1" == "cuda" ]; then
#    cp -rf bin/x64/*.so ../../../../libs/x64
#    cp -rf bin/x64/*.so.* ../../../../libs/x64
#fi

cd ..

