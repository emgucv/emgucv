    "${CMAKE_CURRENT_SOURCE_DIR}/libs/runtimes/ubuntu.*/native/*version_string.inc"
  )
  IF(_ubuntu_vf_list)
    LIST(GET _ubuntu_vf_list 0 _ubuntu_vf)
    GET_FILENAME_COMPONENT(_ubuntu_native_dir "${_ubuntu_vf}" DIRECTORY)
    GET_FILENAME_COMPONENT(_ubuntu_rid_dir "${_ubuntu_native_dir}" DIRECTORY)
    GET_FILENAME_COMPONENT(_ubuntu_rid_name "${_ubuntu_rid_dir}" NAME)
    STRING(REGEX MATCH "^(ubuntu[.][0-9.]+)" _ "${_ubuntu_rid_name}")
    IF(CMAKE_MATCH_1)
      SET(UBUNTU_RID_PREFIX "${CMAKE_MATCH_1}")
    ENDIF()
  ENDIF()
  IF(NOT UBUNTU_RID_PREFIX)
    SET(UBUNTU_RID_PREFIX "ubuntu")
  ENDIF()
  MESSAGE(STATUS "UBUNTU_RID_PREFIX (inferred): ${UBUNTU_RID_PREFIX}")
ENDIF()

