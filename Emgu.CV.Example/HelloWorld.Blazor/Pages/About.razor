@page "/about"

<PageTitle>About — Emgu CV WebAssembly Demo</PageTitle>

<p><a href="">&larr; Back</a></p>

<h1>About</h1>
<h2>Emgu CV / OpenCV build information</h2>

@if (!string.IsNullOrEmpty(error))
{
    <pre style="color:red">@error</pre>
}

@if (!string.IsNullOrEmpty(output))
{
    <pre>@output</pre>
}

@code {
    private string output = string.Empty;
    private string error = string.Empty;

    protected override void OnInitialized()
    {
        try
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine($"ExternLibrary  : {CvInvoke.ExternLibrary}");
            sb.AppendLine($"LibraryLoaded  : {CvInvoke.Init()}");
            sb.AppendLine();
            sb.AppendLine(CvInvoke.BuildInformation);
            output = sb.ToString();
        }
        catch (Exception ex)
        {
            error = $"{ex.GetType().Name}: {ex.Message}\n\n{ex.StackTrace}";
        }
    }
}
