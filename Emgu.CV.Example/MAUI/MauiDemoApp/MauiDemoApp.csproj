<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net8.0-tizen</TargetFrameworks> -->
		<OutputType>Exe</OutputType>
		<RootNamespace>MauiDemoApp</RootNamespace>
		<UseMaui>true</UseMaui>
		
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- <WindowsPackageType>None</WindowsPackageType> -->

		<!-- Display name -->
		<ApplicationTitle>Emgu</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.emgu.cv.maui.demo</ApplicationId>
		<ApplicationIdGuid>FCFFF12F-6AC6-478A-9B4F-DAF46BD6A449</ApplicationIdGuid>



		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <!-- <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion> -->
		<Platforms>AnyCPU;x64</Platforms>

		<AcceptAndroidSDKLicenses>true</AcceptAndroidSDKLicenses>
		<CodesignEntitlements Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">Platforms\MacCatalyst\Entitlements.plist</CodesignEntitlements>
		<!--
		Platforms\iOS\Entitlements.plist requests the raised memory limit the
		multi-gigabyte language models need. It is deliberately NOT wired up by
		default: a free Apple ID's provisioning profile carries no entitlements
		at all, so the build only emits warning MT7140 and the request is
		dropped. Enable this line when signing with a paid developer account.
		<CodesignEntitlements Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">Platforms\iOS\Entitlements.plist</CodesignEntitlements>
		-->

		
		<!-- <WindowsPackageType>None</WindowsPackageType> -->
	</PropertyGroup>

	<!-- Temporary work around MAUI iOS/MacCatalyst AOT compilation issue: https://github.com/dotnet/runtime/issues/109966#issuecomment-2486161265 -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' OR $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
        <MtouchInterpreter>-all,System.Private.Windows.Core,aot-instances</MtouchInterpreter>
    </PropertyGroup>

	<!--
	MSIX signing: uses the same Emgu Corporation EV code-signing certificate that
	EmguSign.bat/SignBinary.Targets use for Authenticode-signing output DLLs
	(installed in Cert:\CurrentUser\My, thumbprint below). Package.appxmanifest's
	Identity Publisher must exactly match this certificate's Subject, or
	MakeAppx/signtool fails with a publisher/cert subject mismatch.
	Only applies to WindowsPackageType=MSIX builds; the unpackaged .exe build
	(WindowsPackageType=None) does not produce or sign an .msix at all.
	-->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
		<PackageCertificateThumbprint>915C6CDEAE1C4D16C872CBD3A8DE7142D79BB661</PackageCertificateThumbprint>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		<!-- <MauiAsset Include="Resources\Raw\**" LogicalName="%(Filename)%(Extension)" /> -->
	</ItemGroup>
	<!--
	License texts shown by LicensePage.cs, bundled straight from each component's
	own source tree rather than copied into this project. Each item is guarded by
	Exists() so a checkout without an optional submodule (e.g. hdf5) still builds;
	LicensePage shows a link to the project instead of a missing text.
	-->
	<PropertyGroup>
		<EmguRoot>$(MSBuildThisFileDirectory)..\..\..\</EmguRoot>
	</PropertyGroup>
	<ItemGroup>
		<LicenseFile Include="$(EmguRoot)LICENSE" LogicalName="emgucv.txt" />
		<!-- opencv, opencv_contrib, tesseract and flatbuffers all ship this same plain Apache-2.0 text. -->
		<LicenseFile Include="$(EmguRoot)opencv\LICENSE" LogicalName="Apache-2.0.txt" />
		<LicenseFile Include="$(EmguRoot)opencv\COPYRIGHT" LogicalName="opencv-copyright.txt" />
		<LicenseFile Include="$(EmguRoot)Emgu.CV.Extern\tesseract\libtesseract\leptonica\leptonica.git\leptonica-license.txt" LogicalName="leptonica.txt" />
		<LicenseFile Include="$(EmguRoot)eigen\COPYING.MPL2" LogicalName="eigen.txt" />
		<LicenseFile Include="$(EmguRoot)opencv\3rdparty\libjpeg-turbo\LICENSE.md" LogicalName="libjpeg-turbo.txt" />
		<LicenseFile Include="$(EmguRoot)opencv\3rdparty\libjpeg-turbo\README.ijg" LogicalName="libjpeg-turbo-ijg.txt" />
		<LicenseFile Include="$(EmguRoot)opencv\3rdparty\libpng\LICENSE" LogicalName="libpng.txt" />
		<LicenseFile Include="$(EmguRoot)opencv\3rdparty\zlib\LICENSE" LogicalName="zlib.txt" />
		<LicenseFile Include="$(EmguRoot)opencv\3rdparty\libtiff\LICENSE.md" LogicalName="libtiff.txt" />
		<LicenseFile Include="$(EmguRoot)opencv\3rdparty\libwebp\COPYING" LogicalName="libwebp.txt" />
		<LicenseFile Include="$(EmguRoot)opencv\3rdparty\openjpeg\LICENSE" LogicalName="openjpeg.txt" />
		<LicenseFile Include="$(EmguRoot)opencv\3rdparty\protobuf\LICENSE" LogicalName="protobuf.txt" />
		<LicenseFile Include="$(EmguRoot)opencv\3rdparty\mlas\LICENSE" LogicalName="mlas.txt" />
		<LicenseFile Include="$(EmguRoot)opencv\3rdparty\ittnotify\src\ittnotify\BSD-3-Clause.txt" LogicalName="ittnotify.txt" />
		<LicenseFile Include="$(EmguRoot)opencv\3rdparty\cpufeatures\LICENSE" LogicalName="cpufeatures.txt" />
		<LicenseFile Include="$(EmguRoot)opencv\modules\core\3rdparty\SoftFloat\COPYING.txt" LogicalName="softfloat.txt" />
		<LicenseFile Include="$(EmguRoot)opencv\modules\features\3rdparty\annoy\LICENSE" LogicalName="annoy.txt" />
		<LicenseFile Include="$(EmguRoot)opencv\modules\features\3rdparty\mscr\chi_table_LICENSE.txt" LogicalName="mscr.txt" />
		<LicenseFile Include="$(EmguRoot)opencv\modules\imgproc\fonts\Rubik_OFL.txt" LogicalName="OFL-1.1.txt" />
		<LicenseFile Include="$(EmguRoot)opencv\hal\carotene\hal\tegra_hal.hpp" LogicalName="carotene.txt" />
		<LicenseFile Include="$(EmguRoot)opencv_contrib\modules\xfeatures2d\src\kaze\LICENSE.KAZE" LogicalName="kaze.txt" />
		<LicenseFile Include="$(EmguRoot)opencv_contrib\modules\xfeatures2d\src\kaze\LICENSE.AKAZE" LogicalName="akaze.txt" />
		<LicenseFile Include="$(EmguRoot)3rdParty\freetype2\docs\FTL.TXT" LogicalName="freetype.txt" />
		<LicenseFile Include="$(EmguRoot)harfbuzz\COPYING" LogicalName="harfbuzz.txt" />
		<LicenseFile Include="$(EmguRoot)hdf5\COPYING" LogicalName="hdf5.txt" />
	</ItemGroup>
	<!-- Inside a target so the Exists() condition can batch over each file. -->
	<Target Name="AddLicenseAssets" BeforeTargets="ResizetizeCollectItems">
		<ItemGroup>
			<MauiAsset Include="@(LicenseFile)" Condition="Exists('%(FullPath)')" LogicalName="licenses\%(LicenseFile.LogicalName)" />
		</ItemGroup>
	</Target>

	<ItemGroup>
	  <None Remove="Resources\Raw\box.png" />
	  <None Remove="Resources\Raw\box_in_scene.png" />
	  <None Remove="Resources\Raw\cars_license_plate.png" />
	  <None Remove="Resources\Raw\dog416.png" />
	  <None Remove="Resources\Raw\imL.png" />
	  <None Remove="Resources\Raw\imR.png" />
	  <None Remove="Resources\Raw\lena.jpg" />
	  <None Remove="Resources\Raw\pedestrian.png" />
	  <None Remove="Resources\Raw\qrcode_barcode.png" />
	  <None Remove="Resources\Raw\stop-sign.jpg" />
	  <None Remove="Resources\Raw\test_image.png" />
	  <None Remove="Resources\Styles\Colors.xaml" />
	  <None Remove="Resources\Styles\Styles.xaml" />
	</ItemGroup>

