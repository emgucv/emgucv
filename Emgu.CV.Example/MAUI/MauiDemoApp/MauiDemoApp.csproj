<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net8.0-tizen</TargetFrameworks> -->
		<OutputType>Exe</OutputType>
		<RootNamespace>MauiDemoApp</RootNamespace>
		<UseMaui>true</UseMaui>
		
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- <WindowsPackageType>None</WindowsPackageType> -->

		<!-- Display name -->
		<ApplicationTitle>Emgu</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.emgu.cv.maui.demo</ApplicationId>
		<ApplicationIdGuid>FCFFF12F-6AC6-478A-9B4F-DAF46BD6A449</ApplicationIdGuid>



		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <!-- <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion> -->
		<Platforms>AnyCPU;x64;arm64;x86</Platforms>

		<AcceptAndroidSDKLicenses>true</AcceptAndroidSDKLicenses>
		<CodesignEntitlements Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">Platforms\MacCatalyst\Entitlements.plist</CodesignEntitlements>
		<!--
		Platforms\iOS\Entitlements.plist requests the raised memory limit the
		multi-gigabyte language models need. It is deliberately NOT wired up by
		default: a free Apple ID's provisioning profile carries no entitlements
		at all, so the build only emits warning MT7140 and the request is
		dropped. Enable this line when signing with a paid developer account.
		<CodesignEntitlements Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">Platforms\iOS\Entitlements.plist</CodesignEntitlements>
		-->

		
		<!-- <WindowsPackageType>None</WindowsPackageType> -->
	</PropertyGroup>

	<!-- Temporary work around MAUI iOS/MacCatalyst AOT compilation issue: https://github.com/dotnet/runtime/issues/109966#issuecomment-2486161265 -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' OR $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
        <MtouchInterpreter>-all,System.Private.Windows.Core,aot-instances</MtouchInterpreter>
    </PropertyGroup>

	<!--
	MSIX signing: uses the same Emgu Corporation EV code-signing certificate that
	EmguSign.bat/SignBinary.Targets use for Authenticode-signing output DLLs
	(installed in Cert:\CurrentUser\My, thumbprint below). Package.appxmanifest's
	Identity Publisher must exactly match this certificate's Subject, or
	MakeAppx/signtool fails with a publisher/cert subject mismatch.
	Only applies to WindowsPackageType=MSIX builds; the unpackaged .exe build
	(WindowsPackageType=None) does not produce or sign an .msix at all.
	-->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
		<PackageCertificateThumbprint>915C6CDEAE1C4D16C872CBD3A8DE7142D79BB661</PackageCertificateThumbprint>
		<!--
		Overrides the Appx packaging targets' default package filename stem, which is otherwise
		"$(MSBuildProjectName)_$(AppxManifestIdentityVersion)_$(Platform)" (e.g.
		"MauiDemoApp_5.1.0.6716_x64"): underscore-separated and keyed off the literal .csproj
		file name, not something settable via $(ProjectName) alone since the vendor targets
		(Microsoft.Build.Msix.Packaging.targets) hardcode the "_" separators and field order
		when deriving AppxPackageName. Setting AppxPackageName directly bypasses that derivation
		entirely, giving "Emgu.CV.Maui.Demo.windows.x64.5.1.0.6716.msix" once AppxPackageExtension
		(".msix") is appended. $(EmguCVPackageVersion) comes from Directory.Build.props (see
		Directory.Build.props.in), kept in sync with Package.appxmanifest's Identity Version:
		both are substituted from the same CMake variables at configure time.
		-->
		<AppxPackageName>Emgu.CV.Maui.Demo.windows.$(Platform).$(EmguCVPackageVersion)</AppxPackageName>
	</PropertyGroup>

	<!--
	A copy of the signed Android package named like the MSIX above:
	"Emgu.CV.Maui.Demo.android.5.1.0.6717.apk" beside "com.emgu.cv.maui.demo-Signed.apk".
	The Android SDK names its packages after the ApplicationId, and its signing step derives
	the signed file's name from that too, so the SDK's own names are left alone (install and
	run keep using them) and the signed package is copied once it is made: by _Sign for an .apk
	build (Debug), or by _CreateUniversalApkFromBundle for an .aab build (Release, where the
	universal "-Signed.apk" is made from the bundle after _Sign). A target runs only once per
	build, hence one target for each.
	cmake/CopyMauiApk.cmake copies only this file to {root}/package when it exists.
	-->
	<Target Name="EmguCVCopyVersionedApk" AfterTargets="_Sign" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(EmguCVPackageVersion)' != '' And '$(AndroidPackageFormat)' != 'aab'">
		<Copy SourceFiles="$(ApkFileSigned)" DestinationFiles="$(OutDir)Emgu.CV.Maui.Demo.android.$(EmguCVPackageVersion).apk" SkipUnchangedFiles="true" Condition="Exists('$(ApkFileSigned)')" />
	</Target>
	<Target Name="EmguCVCopyVersionedUniversalApk" AfterTargets="_CreateUniversalApkFromBundle" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(EmguCVPackageVersion)' != '' And '$(AndroidPackageFormat)' == 'aab'">
		<Copy SourceFiles="$(ApkFileSigned)" DestinationFiles="$(OutDir)Emgu.CV.Maui.Demo.android.$(EmguCVPackageVersion).apk" SkipUnchangedFiles="true" Condition="Exists('$(ApkFileSigned)')" />
	</Target>

	<!--
	Android Release signing with the Emgu keystore, when it is available; otherwise (and for Debug)
	the Android SDK signs with its own debug key, as before. An APK signed with one key can't
	update an app installed from one signed with another, so released APKs need the same key
	every time. The keystore and its passwords are never in the repository; set:
	  EMGU_ANDROID_KEYSTORE            the keystore file's full path
	  EMGU_ANDROID_KEYSTORE_PASS_FILE  the full path of a file that holds its password, or
	  EMGU_ANDROID_KEYSTORE_PASS       its password
	  EMGU_ANDROID_KEY_ALIAS           the key's alias (default "emgu")
	  EMGU_ANDROID_KEY_PASS            the key's password (default: the keystore's password)
	The passwords are passed as "file:PATH" or "env:NAME", which the Android SDK reads itself,
	so they don't appear on a command line or in a build log. Prefer the file on a build
	machine: a build server that logs each step's environment (buildbot does) would log a
	password held in a variable, but only the path of a file. The file wins when both are set.
	-->
	<PropertyGroup>
		<_EmguCVAndroidStorePass Condition="'$(EMGU_ANDROID_KEYSTORE_PASS_FILE)' != '' And Exists('$(EMGU_ANDROID_KEYSTORE_PASS_FILE)')">file:$(EMGU_ANDROID_KEYSTORE_PASS_FILE)</_EmguCVAndroidStorePass>
		<_EmguCVAndroidStorePass Condition="'$(_EmguCVAndroidStorePass)' == '' And '$(EMGU_ANDROID_KEYSTORE_PASS)' != ''">env:EMGU_ANDROID_KEYSTORE_PASS</_EmguCVAndroidStorePass>
	</PropertyGroup>
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(Configuration)' == 'Release' And '$(EMGU_ANDROID_KEYSTORE)' != '' And Exists('$(EMGU_ANDROID_KEYSTORE)') And '$(_EmguCVAndroidStorePass)' != ''">
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>$(EMGU_ANDROID_KEYSTORE)</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias Condition="'$(EMGU_ANDROID_KEY_ALIAS)' != ''">$(EMGU_ANDROID_KEY_ALIAS)</AndroidSigningKeyAlias>
		<AndroidSigningKeyAlias Condition="'$(EMGU_ANDROID_KEY_ALIAS)' == ''">emgu</AndroidSigningKeyAlias>
		<AndroidSigningStorePass>$(_EmguCVAndroidStorePass)</AndroidSigningStorePass>
		<AndroidSigningKeyPass Condition="'$(EMGU_ANDROID_KEY_PASS)' != ''">env:EMGU_ANDROID_KEY_PASS</AndroidSigningKeyPass>
		<AndroidSigningKeyPass Condition="'$(EMGU_ANDROID_KEY_PASS)' == ''">$(_EmguCVAndroidStorePass)</AndroidSigningKeyPass>
		<_EmguCVAndroidSigning>the Emgu keystore ($(EMGU_ANDROID_KEYSTORE), alias $(AndroidSigningKeyAlias))</_EmguCVAndroidSigning>
	</PropertyGroup>
	<Target Name="EmguCVReportAndroidSigning" BeforeTargets="_Sign" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(Configuration)' == 'Release'">
		<Message Importance="high" Condition="'$(_EmguCVAndroidSigning)' != ''" Text="Signing the Android package with $(_EmguCVAndroidSigning)." />
		<Warning Condition="'$(_EmguCVAndroidSigning)' == ''" Text="EMGU_ANDROID_KEYSTORE and EMGU_ANDROID_KEYSTORE_PASS_FILE (or EMGU_ANDROID_KEYSTORE_PASS) are not set, or the keystore or password file doesn't exist: the Release Android package is signed with this machine's debug key, so it can't update an install signed with the Emgu key." />
	</Target>

	<!--
	Mac Catalyst Release signing for download outside the Mac App Store (e.g. from a GitHub
	release), when a "Developer ID Application" identity is in the keychain; otherwise the
	SDK signs ad hoc, as before, which Gatekeeper blocks on other Macs. "Apple Distribution"
	can't be used: it is for the Mac App Store only. Set:
	  EMGU_MACCATALYST_CODESIGN_KEY  the identity to sign with (default: the first
	                                 "Developer ID Application" identity in the keychain)
	  EMGU_NOTARY_PROFILE            the notarytool keychain profile (default "emgu-notary";
	                                 made with "xcrun notarytool store-credentials")
	The SDK reads CodesignKey into _SpecifiedCodesignKey before this file is evaluated, and
	the identity is looked up by running "security", so both are set by a target that runs
	before the SDK detects the signing identity. Notarization needs the hardened runtime and
	a secure timestamp; UseHardenedRuntime turns on both.
	-->
	<Target Name="EmguCVDetectMacCatalystSigning" BeforeTargets="_DetectSigningIdentity" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' And '$(Configuration)' == 'Release'">
		<Exec Condition="'$(EMGU_MACCATALYST_CODESIGN_KEY)' == ''" Command="security find-identity -v -p codesigning | sed -n 's/.*&quot;\(Developer ID Application: .*\)&quot;.*/\1/p' | head -n 1" ConsoleToMSBuild="true" StandardOutputImportance="low">
			<Output TaskParameter="ConsoleOutput" PropertyName="_EmguCVMacCatalystCodesignKey" />
		</Exec>
		<PropertyGroup>
			<_EmguCVMacCatalystCodesignKey Condition="'$(EMGU_MACCATALYST_CODESIGN_KEY)' != ''">$(EMGU_MACCATALYST_CODESIGN_KEY)</_EmguCVMacCatalystCodesignKey>
		</PropertyGroup>
		<PropertyGroup Condition="'$(_EmguCVMacCatalystCodesignKey)' != ''">
			<EnableCodeSigning>true</EnableCodeSigning>
			<CodesignKey>$(_EmguCVMacCatalystCodesignKey)</CodesignKey>
			<_SpecifiedCodesignKey>$(_EmguCVMacCatalystCodesignKey)</_SpecifiedCodesignKey>
			<UseHardenedRuntime>true</UseHardenedRuntime>
		</PropertyGroup>
		<Message Importance="high" Condition="'$(_EmguCVMacCatalystCodesignKey)' != ''" Text="Signing the Mac Catalyst app with &quot;$(_EmguCVMacCatalystCodesignKey)&quot;, hardened runtime." />
		<Warning Condition="'$(_EmguCVMacCatalystCodesignKey)' == ''" Text="No &quot;Developer ID Application&quot; signing identity in the keychain and EMGU_MACCATALYST_CODESIGN_KEY is not set: the Release Mac Catalyst app is signed ad hoc and isn't packaged for download." />
	</Target>

	<!--
	The signed app, notarized and stapled when the notary profile works, zipped as
	"Emgu.CV.Maui.Demo.maccatalyst.arm64.5.1.0.6717.zip" beside the .app (the name matches the
	Android and Windows packages). A stapled app opens on other Macs without a network check.
	If notarization fails the zip still holds the signed app, and the build warns: Gatekeeper
	blocks an app that isn't notarized when it is downloaded.
	With RuntimeIdentifiers set (as the CMake build does), the app bundle is made by an inner
	build for each RID and signed by the outer one, so this runs after Codesign, in the build
	where the bundle was actually signed (_CodesignAppBundleCondition).
	cmake/CopyMauiApk.cmake copies the zip to {root}/package.
	-->
	<Target Name="EmguCVPackageMacCatalystApp" AfterTargets="Codesign" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' And '$(_EmguCVMacCatalystCodesignKey)' != '' And '$(EmguCVPackageVersion)' != '' And '$(_CodesignAppBundleCondition)' == 'true'">
		<PropertyGroup>
			<_EmguCVMacCatalystApp>$(AppBundleDir.TrimEnd('/'))</_EmguCVMacCatalystApp>
			<_EmguCVMacCatalystRid>$(RuntimeIdentifier)</_EmguCVMacCatalystRid>
			<_EmguCVMacCatalystRid Condition="'$(_EmguCVMacCatalystRid)' == ''">$(RuntimeIdentifiers)</_EmguCVMacCatalystRid>
			<_EmguCVMacCatalystArch>$(_EmguCVMacCatalystRid.Replace('maccatalyst-', ''))</_EmguCVMacCatalystArch>
			<_EmguCVMacCatalystArch Condition="$(_EmguCVMacCatalystArch.Contains(';'))">universal</_EmguCVMacCatalystArch>
			<_EmguCVMacCatalystZip>$([System.IO.Path]::GetDirectoryName('$(_EmguCVMacCatalystApp)'))/Emgu.CV.Maui.Demo.maccatalyst.$(_EmguCVMacCatalystArch).$(EmguCVPackageVersion).zip</_EmguCVMacCatalystZip>
			<_EmguCVNotaryProfile>$(EMGU_NOTARY_PROFILE)</_EmguCVNotaryProfile>
			<_EmguCVNotaryProfile Condition="'$(_EmguCVNotaryProfile)' == ''">emgu-notary</_EmguCVNotaryProfile>
		</PropertyGroup>
		<Delete Files="$(_EmguCVMacCatalystZip)" />
		<Exec Command="ditto -c -k --sequesterRsrc --keepParent &quot;$(_EmguCVMacCatalystApp)&quot; &quot;$(_EmguCVMacCatalystZip)&quot;" />
		<Exec Command="xcrun notarytool submit &quot;$(_EmguCVMacCatalystZip)&quot; --keychain-profile &quot;$(_EmguCVNotaryProfile)&quot; --wait &amp;&amp; xcrun stapler staple &quot;$(_EmguCVMacCatalystApp)&quot;" ContinueOnError="true" IgnoreStandardErrorWarningFormat="true">
			<Output TaskParameter="ExitCode" PropertyName="_EmguCVNotaryExitCode" />
		</Exec>
		<Delete Files="$(_EmguCVMacCatalystZip)" Condition="'$(_EmguCVNotaryExitCode)' == '0'" />
		<Exec Command="ditto -c -k --sequesterRsrc --keepParent &quot;$(_EmguCVMacCatalystApp)&quot; &quot;$(_EmguCVMacCatalystZip)&quot;" Condition="'$(_EmguCVNotaryExitCode)' == '0'" />
		<Message Importance="high" Condition="'$(_EmguCVNotaryExitCode)' == '0'" Text="Notarized and stapled: $(_EmguCVMacCatalystZip)" />
		<Warning Condition="'$(_EmguCVNotaryExitCode)' != '0'" Text="Notarizing the Mac Catalyst app with the notarytool profile &quot;$(_EmguCVNotaryProfile)&quot; failed, so $(_EmguCVMacCatalystZip) holds a signed app that isn't notarized." />
	</Target>

